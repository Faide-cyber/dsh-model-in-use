{
  "name": "dsh-model-in-use",
  "version": "0.1.0",
  "description": "DSH model-menu enhancements: dots for models in use by other running sessions, per-model reasoning-effort memory, collapsed group state, and menu spacing fixes.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/Faide-cyber/dsh-model-in-use",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faide-cyber/dsh-model-in-use.git"
  },
  "bugs": {
    "url": "https://github.com/Faide-cyber/dsh-model-in-use/issues"
  },
  "author": "Faide-cyber",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "model",
    "conversation",
    "reasoning-effort",
    "memory",
    "web"
  ],
  "license": "MIT"
}
